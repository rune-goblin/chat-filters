{
  "name": "chat-filters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search and filter the Foundry VTT chat log.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/pack.ts && vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:e2e": "tsc --noEmit -p src/tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:setup": "node scripts/setup-test-env.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:foundry": "bash scripts/start-test-env.sh",
    "clean": "rm -rf dist",
    "setup": "node scripts/setup.ts",
    "deploy": "node scripts/deploy.ts",
    "pack": "fvtt package pack",
    "unpack": "fvtt package unpack",
    "build:adventure": "node scripts/build-adventure.ts",
    "normalize": "node scripts/normalize-refs.ts"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.3",
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22.12.0",
    "@vitest/ui": "^4.1.9",
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@14.366.0-beta.20260821132143",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.4",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
